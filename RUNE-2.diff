+
+    private static void AssertNear(Color actual, Color expected)
+    {
+        var d = Math.Abs(actual.R - expected.R) + Math.Abs(actual.G - expected.G) + Math.Abs(actual.B - expected.B);
+        Assert.True(d < 60, $"expected ~{expected}, got {actual}");
+    }
