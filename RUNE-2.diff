+    {
+        Assert.Equal(3, RuneMarkerPainter.FrameThickness(new Rectangle(0, 0, 45, 45)));
+        Assert.Equal(2, RuneMarkerPainter.FrameThickness(new Rectangle(0, 0, 20, 20)));
