+        var restRing = cells.Count > 1
+            ? cells.Select(c => c.GoldHueRingProportion).OrderByDescending(r => r).Skip(1).Max()
+            : 0;
+
+        return (cells.Count * 100_000)
+            + (int)((bestRing - restRing) * 20_000)
+            - (spread * 200)
+            - (squareness * 20);
+    }
